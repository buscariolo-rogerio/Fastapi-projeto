# Provedores e bancos usados pelo Assessor.AI.
GEMINI_API_KEY=<sua-chave-gemini>
GROQ_API_KEY=<sua-chave-groq>
TYPESAFE_API_KEY=<sua-chave-typesafe-opcional>
DATABASE_URL=<postgresql://usuario:senha@host:5432/banco>
MONGODB_URI=<mongodb://host:27017>
MONGODB_DB=assessor
QDRANT_URL=<https://seu-cluster.qdrant.io>
QDRANT_API_KEY=<sua-chave-qdrant>

# LangSmith é opcional. Preencha a chave somente no .env local para enviar
# traces externos; o painel /monitor funciona mesmo sem essa integração.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<sua-chave-langsmith>
LANGSMITH_PROJECT=assessor-ai
